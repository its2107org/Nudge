# Builds Nudge and sends it to TestFlight.
# Uses the same Apple details (GitHub organization secrets) and signing store
# (Match-Secrets) as the owner's other browser-built apps. It only ever adds
# Nudge's own entries; it never changes or removes anything belonging to other apps.

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

BUNDLE_ID = "com.#{TEAMID}.nudge"
WIDGET_ID = "#{BUNDLE_ID}.widget"
PROJECT = "#{GITHUB_WORKSPACE}/Nudge.xcodeproj"

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: FASTLANE_KEY_ID,
      issuer_id: FASTLANE_ISSUER_ID,
      key_content: FASTLANE_KEY
    )
  end

  desc "Register Nudge's identifiers and make its signing profiles (safe to repeat)"
  lane :setup do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    api_key

    [["Nudge", BUNDLE_ID], ["Nudge Widget", WIDGET_ID]].each do |name, identifier|
      Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name: name,
        identifier: identifier,
        platform: "IOS"
      )
    end

    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [BUNDLE_ID, WIDGET_ID]
    )
  end

  desc "Check the App Store Connect app record exists"
  lane :check_app_record do
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    File.write(File.expand_path("app_record_exists.txt"), app ? "true" : "false")
    UI.message(app ? "App record found: #{app.name}" : "No App Store Connect app record for #{BUNDLE_ID} yet")
  end

  desc "Build Nudge"
  lane :build_nudge do
    setup_ci if ENV['CI']
    key = api_key

    update_project_team(path: PROJECT, teamid: TEAMID)

    previous = latest_testflight_build_number(app_identifier: BUNDLE_ID, api_key: key, initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: previous + 1)

    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [BUNDLE_ID, WIDGET_ID]
    )

    mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    update_code_signing_settings(
      path: PROJECT,
      profile_name: mapping[BUNDLE_ID],
      code_sign_identity: "iPhone Distribution",
      targets: ["Nudge"]
    )
    update_code_signing_settings(
      path: PROJECT,
      profile_name: mapping[WIDGET_ID],
      code_sign_identity: "iPhone Distribution",
      targets: ["NudgeWidget"]
    )

    gym(
      export_method: "app-store",
      scheme: "Nudge",
      output_name: "Nudge.ipa",
      configuration: "Release",
      destination: "generic/platform=iOS",
      xcargs: "DEVELOPMENT_TEAM=#{TEAMID}",
      buildlog_path: "buildlog"
    )
  end

  desc "Send to TestFlight"
  lane :release do
    upload_to_testflight(
      api_key: api_key,
      ipa: "Nudge.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Automatic build " + last_git_commit[:abbreviated_commit_hash]
    )
  end
  desc "Make sure the owner is set up as a TestFlight tester (safe to repeat)"
  lane :testers do
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app for #{BUNDLE_ID}") unless app

    group = app.get_beta_groups.find { |g| g.name == "Me" }
    unless group
      # Sent by hand: fastlane's own helper adds a public-link setting Apple now rejects for internal groups.
      Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: { name: "Me", isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { type: "apps", id: app.id } } }
        }
      })
      group = app.get_beta_groups.find { |g| g.name == "Me" }
      UI.user_error!("Group 'Me' was not created") unless group
      UI.success("Created internal TestFlight group 'Me' with automatic distribution")
    end

    users = Spaceship::ConnectAPI::User.all
    UI.message("Found #{users.count} App Store Connect user(s)")
    users.each do |user|
      email = user.email.to_s.empty? ? user.username.to_s : user.email.to_s
      next if email.empty?
      begin
        Spaceship::ConnectAPI.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: email, firstName: user.first_name, lastName: user.last_name }
        )
        UI.success("Added a team member to the 'Me' TestFlight group")
      rescue => e
        UI.important("Tester not added (may already be in the group): #{e.message}")
      end
    end

    testers = Spaceship::ConnectAPI::BetaTester.all(filter: { betaGroups: group.id })
    UI.user_error!("No testers in the 'Me' group") if testers.empty?
    UI.success("'Me' group has #{testers.count} tester(s)")

    # Give the newest build to the group too, in case it arrived before the group existed.
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 1).first
    if build
      begin
        build.add_beta_groups(beta_groups: [group])
        UI.success("Newest build shared with the group")
      rescue => e
        UI.important("Could not share newest build yet (#{e.message}); automatic distribution will cover it")
      end
    end
  end
  desc "Print TestFlight status: builds, their state, and testers"
  lane :status do
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app for #{BUNDLE_ID}") unless app
    Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 5).each do |b|
      detail = b.build_beta_detail
      UI.message("BUILD #{b.version}: processing=#{b.processing_state} internal=#{detail&.internal_build_state} expired=#{b.expired} encryption=#{b.uses_non_exempt_encryption.inspect} minOS=#{b.min_os_version} uploaded=#{b.uploaded_date}")
    end
    app.get_beta_groups.each do |g|
      UI.message("GROUP #{g.name}: internal=#{g.is_internal_group} allBuilds=#{g.has_access_to_all_builds}")
      Spaceship::ConnectAPI::BetaTester.all(filter: { betaGroups: g.id }).each do |t|
        UI.message("  TESTER state=#{t.beta_tester_state} invite=#{t.invite_type} devices=#{t.number_of_installed_devices.inspect}")
      end
    end
  end
end
